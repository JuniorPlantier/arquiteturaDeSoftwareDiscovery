        <mxCell id="GtqTjdAPlB-UweOahyPA-4" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Cliente / Servidor&lt;/h1&gt;&lt;p&gt;Topologia de rede que separa quem solicita recursos (Client) de quem processa e centraliza dados (Server).&amp;nbsp;&lt;/p&gt;&lt;p&gt;Comunicando com via Request e Response.&lt;/p&gt;&lt;p&gt;Principal custo: O servidor vira ponto único de gargalo e falha se não houver escalabilidade horizontal, balanceamento ou cache.&lt;/p&gt;" vertex="1">
          <mxGeometry height="140" width="610" x="40" y="-511" as="geometry" />
        </mxCell>
        <mxCell id="GtqTjdAPlB-UweOahyPA-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Monolítica&lt;/h1&gt;&lt;p&gt;Aplicação implantada com um único pacote, compartilhando processo, memória e BD.&lt;/p&gt;&lt;p&gt;Ganho: Simplicidade e velocidade&amp;nbsp;&lt;/p&gt;&lt;p&gt;Principal Custo: Acoplamento e deploy acoplado&lt;/p&gt;" vertex="1">
