        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d6b656;fillColor=#fff2cc;align=center;verticalAlign=middle;rounded=0;fontColor=#FF9933;" value="&lt;h2&gt;&lt;b&gt;Arquitetura de Software&lt;/b&gt;&lt;/h2&gt;" vertex="1">
          <mxGeometry height="30" width="240" x="10" y="20" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Software = linhas de código = &lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;b&gt;texto&amp;nbsp;&lt;/b&gt;&lt;/span&gt;(muitos textos)" vertex="1">
