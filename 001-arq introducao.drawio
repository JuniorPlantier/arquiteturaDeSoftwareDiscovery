          <mxGeometry height="478" width="885" x="1350" y="2175" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-31" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="455" width="902" x="2260" y="2175" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-32" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="Como criar arquitetura de software?" vertex="1">
          <mxGeometry height="30" width="265" x="23" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-33" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontColor=#46495D;" value="Arquitetura de software = AQs + estilos arquiteturais&lt;br&gt;--&lt;br&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Significa implementar todas as tecnologias necessárias e compatíveis.&lt;/span&gt;&lt;/div&gt;" vertex="1">
