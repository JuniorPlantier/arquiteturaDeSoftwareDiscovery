        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="O&amp;nbsp;&lt;b style=&quot;color: rgb(255, 0, 0); text-align: left;&quot;&gt;texto&amp;nbsp;&lt;/b&gt;passa por um compilador que se transforma numa linguagem de máquina (binário):&amp;nbsp;" vertex="1">
          <mxGeometry height="30" width="520" x="10" y="100" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Mas a dimensão desses&amp;nbsp;&lt;b style=&quot;color: rgb(255, 0, 0);&quot;&gt;textos&lt;/b&gt;, ficam tão grande, que fica difícil de entender o que cada funcionalidade/serviço/recurso faz." vertex="1">
          <mxGeometry height="30" width="370" x="19" y="373" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-7" parent="1" style="image;sketch=0;aspect=fixed;html=1;align=center;fontSize=12;image=img/lib/mscae/eBooks.svg;points=[[0.5,0.048,0],[0.5,0.997,0],[0,0.497,0],[1,0.497,0],[0.992,0.052,0],[0.99,0.945,0],[0.01,0.945,0],[0.008,0.052,0]];labelPerimeter=1;" value="" vertex="1">
          <mxGeometry height="41" width="50" x="19" y="450" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Por que precisamos de Arquitetura?&lt;br&gt;Imagine um livro de 1.000 páginas sem índice, sem capítulos e sem numeração. Como encontrar uma informação específica ali dentro?&lt;br&gt;É exatamente para organizar esse caos que entra a &lt;b&gt;Arquitetura de Software.&lt;/b&gt;&lt;br&gt;Ela trata justamente de:" vertex="1">
          <mxGeometry height="107.65" width="550" x="80" y="420" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-9" parent="1" style="shape=singleArrow;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="30" width="70" x="30" y="520" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-10" parent="1" style="shape=singleArrow;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="30" width="70" x="30" y="560" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-11" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Como as partes se comunicam e como se interagem entre si" vertex="1">
          <mxGeometry height="30" width="342.8" x="102" y="520.65" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-12" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Como segmentar o código/software em partes,&amp;nbsp;é a forma como o software é organizado." vertex="1">
          <mxGeometry height="30" width="342.8" x="102" y="563" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="A descrição arquitetural é muito importante.&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;Como representar? Como tomar forma?" vertex="1">
          <mxGeometry height="30" width="265" x="30" y="668" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Partes" vertex="1">
          <mxGeometry height="60" width="120" x="30" y="710" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Partes" vertex="1">
          <mxGeometry height="60" width="120" x="324.8" y="708" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-16" edge="1" parent="1" source="5FTdrS58FLfuJ8CFRZ6S-14" style="endArrow=classic;startArrow=classic;html=1;rounded=0;defaultLabelBackgroundColor=page;labelPadding=0 4;" target="5FTdrS58FLfuJ8CFRZ6S-15" value="Como se conectam">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="330" y="730" as="sourcePoint" />
            <mxPoint x="380" y="680" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-17" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="462" width="723" x="490" y="708" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-18" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="476.5" width="834.11" x="1240" y="710" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Assim como em qualquer engenharia, modelamos o sistema antes de construir para:&lt;br&gt;-Vislumbrar como a solução vai funcionar.&lt;br&gt;-Planejar etapas, prazos e recursos.&lt;br&gt;-Engajar o cliente.&lt;br&gt;A visão completa é consolidada na Documentação Arquitetural.&lt;br&gt;--&lt;br&gt;Existem diferentes visões e formas de representar.&lt;br&gt;Analogia: Na construção de um prédio, usamos planta hidráulica, elétrica e maquete. &lt;br&gt;No software, usamos múltiplos modelos para o mesmo sistema.&lt;br&gt;Formatos mais comuns:&lt;br&gt;Rascunhos e desenhos informais&lt;br&gt;Diagramas padronizados (ex: UML, SysML)&lt;br&gt;Descrições textuais e especificações.&lt;br&gt;etc" vertex="1">
          <mxGeometry height="220" width="448" x="30" y="788" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-20" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="251" width="638.91" x="350" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-21" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="208" width="607" x="1020" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#d79b00;fillColor=#ffe6cc;align=center;verticalAlign=middle;rounded=0;" value="Padrão Arquitetural" vertex="1">
          <mxGeometry height="30" width="265" x="40" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Padrão = Solução reutilizável e adaptável para um problema recorrente.&lt;br&gt;--&lt;br&gt;Padrão Arquitetural, é uma organização canônica, que guia a forma que o software será modularizado, ou seja, como será feita a separação entre as funcionalidade e como eles irão interagir.&lt;br&gt;--&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="265" x="40" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;rounded=0;" value="Atributo de Qualidade" vertex="1">
          <mxGeometry height="30" width="265" x="23" y="1635" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-26" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="411" width="653" x="517" y="1639" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-27" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="378" width="666" x="1200" y="1635" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-28" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Propriedades mensuráveis e testáveis que indicam o quão bem o sistema atende às necessidades dos usuários.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Exemplos e Como Medir(Ótimo para formatar em tabela ou 4 blocos lado a lado)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Desempenho → Medido por: Tempo de resposta e latência.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Usabilidade → Medido por: Testes práticos com usuários reais.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Segurança → Medido por: Testes de intrusão e simulação de ataques.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Manutenibilidade → Medido por: Tempo para corrigir falhas ou evoluir o código.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="440" x="23" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="5FTdrS58FLfuJ8CFRZ6S-29" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="478" width="838" x="490" y="2185" as="geometry" />
        </mxCell>
